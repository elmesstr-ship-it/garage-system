generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(USER)

  phone         String?

  isVerified        Boolean @default(false)

  // 🔥 مهم جدًا
  verificationToken String? @unique

  vehicles      Vehicle[]
  bookings      Booking[]
  reservations  Reservation[]
  payments      Payment[]
  notifications Notification[]

  createdAt     DateTime @default(now())
}

/* ---------------- VEHICLE ---------------- */
model Vehicle {
  id          Int      @id @default(autoincrement())
  plateNumber String
  brand       String
  model       String
  color       String

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

/* ---------------- BOOKING ---------------- */
model Booking {
  id          Int      @id @default(autoincrement())

  carNumber   String
  slotNumber  String
  status      String   @default("active")

  startTime   DateTime @default(now())
  endTime     DateTime?

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

/* ---------------- RESERVATION ---------------- */
model Reservation {
  id          Int      @id @default(autoincrement())

  slotNumber  String
  startTime   DateTime
  endTime     DateTime

  status      String   @default("active")

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

/* ---------------- PAYMENT ---------------- */
model Payment {
  id          Int      @id @default(autoincrement())

  amount      Float
  status      String   @default("pending")
  method      String

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

/* ---------------- NOTIFICATION ---------------- */
model Notification {
  id          Int      @id @default(autoincrement())

  title       String
  message     String
  isRead      Boolean  @default(false)

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}